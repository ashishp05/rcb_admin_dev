# Backend API base URL (no trailing slash)
VITE_BASE_URL=http://localhost:4000/api/v1

# Application route prefix (e.g. /admin)
VITE_PATH_PREFIX=/admin

# Secret key used to encrypt Redux state in localStorage
VITE_CIPHER=your-secret-cipher-key


# Venue managed by this panel
VITE_VENUE_ID=arena

# Customer booking site (for links)
VITE_PUBLIC_SITE_URL=http://localhost:5173
